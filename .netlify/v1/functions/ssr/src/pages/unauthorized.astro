---
import Layout from "../layouts/Layout.astro";
import SignOut from "../components/SignOut.astro";

import { Button } from "antd";
---

<Layout title="Unauthorized">
  <div class="text-center mx-4 my-4">
    <h1 class="text-3xl font-semibold my-4">Error: Unauthorized</h1>
    <h2 class="text-lg my-4">
      Your account is not authorized to access this section of the JumboCode
      developer selection portal. You must be signed with an authorized @tufts.edu email address.
    </h2>
    <div class="inline-block">
      <Button className="my-4 mb-8" type="primary" shape="round" size="large" href="/dashboard" client:load> Dashboard </Button>
      <SignOut />
    </div>
  </div>
</Layout>
