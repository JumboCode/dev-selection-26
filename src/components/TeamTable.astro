---
interface Props {
  rows: {
    key: string;
    name: string;
    email: string;
    role: string;
  };
}

const { rows } = Astro.props;

import { Space, Table } from "antd";
const { Column, ColumnGroup } = Table;

const dataSource = [
  {
    key: "1",
    name: "Mike",
    age: 32,
    address: "10 Downing Street",
  },
  {
    key: "2",
    name: "John",
    age: 42,
    address: "10 Downing Street",
  },
];

const columns = [
  {
    title: "Name",
    dataIndex: "name",
    key: "name",
  },
  {
    title: "Email",
    dataIndex: "email",
    key: "email",
  },
  {
    title: "Role",
    dataIndex: "role",
    key: "role",
  },
];
---

<div class="bg-white rounded-xl">
  <Table
    dataSource={rows}
    columns={columns}
    client:load
    scroll={{ x: "max-content" }}
  />
</div>
