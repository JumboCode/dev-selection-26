---
interface Props {
  rows: {
    key: string;
    name: string;
    email: string;
    role: string;
  };
}

const { rows } = Astro.props;

import { Table } from "antd";

const columns = [
  {
    title: "Name",
    dataIndex: "name",
    key: "name",
  },
  {
    title: "Email",
    dataIndex: "email",
    key: "email",
  },
  {
    title: "Role",
    dataIndex: "role",
    key: "role",
  },
];
---

<div class="bg-white rounded-xl">
  <Table
    dataSource={rows as any}
    columns={columns}
    client:load
    scroll={{ x: "max-content" }}
  />
</div>
