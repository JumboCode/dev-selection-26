---
import Layout from "../layouts/Layout.astro";
import { createAuthenticatedSupabaseClient } from "../lib/supabase";
import SignOut from "../components/SignOut.astro";
import TeamTable from "../components/TeamTable.astro";
import StatusTable from "../components/StatusTable.tsx";
import ConfirmedRoster, {
  type ConfirmedDeveloper,
} from "../components/ConfirmedRoster.tsx";
import { teamLabel } from "../lib/teams";
import { Card } from "antd";

const { cookies } = Astro;

const auth = await createAuthenticatedSupabaseClient(cookies);
if (!auth) {
  return Astro.redirect("/");
}

const { supabase, user } = auth;

const { data: userRole, error: userRoleError } = await supabase
  .from("user_roles")
  .select("*")
  .ilike("email", user.email ?? "")
  .maybeSingle();

if (userRoleError) {
  console.error(userRoleError);
}

// Default user role if not found in user_roles table
const defaultUserRole = {
  first_name: user.email?.split('@')[0] || 'User',
  team_name: 'General',
  role: 'User'
};

const finalUserRole = userRole || defaultUserRole;

let selectionStatus: any = undefined;
// Get all active dev selection statuses (if board)
if (finalUserRole.team_name === "Board") {
  const { data: teamSelectStatus, error: teamSelectStatusError } =
    await supabase.from("team_status").select("*");
  if (teamSelectStatusError) {
    console.error(teamSelectStatusError);
  }
  selectionStatus = teamSelectStatus;
} else {
  const { data: teamSelectStatus, error: teamSelectStatusError } =
    await supabase
      .from("team_status")
      .select("*")
      .eq("team_name", finalUserRole.team_name);
  selectionStatus = teamSelectStatus;
  if (teamSelectStatusError) {
    console.error(teamSelectStatusError);
  }
}

// Get this team's leaders
const { data: teamLeadersQuery, error: teamLeadersError } = await supabase
  .from("user_roles")
  .select("email, role, first_name")
  .eq("team_name", finalUserRole.team_name);
if (teamLeadersError) {
  console.error(teamLeadersError);
}

// Real names and emails of developers on approved (Complete) teams. The
// database function only returns teams this user belongs to or reviews.
const { data: confirmedRows, error: confirmedError } = await supabase.rpc(
  "get_confirmed_roster",
);
if (confirmedError) {
  console.error(confirmedError);
}

const teamLabels = new Map<string, string>(
  (selectionStatus ?? []).map((row: any) => [
    row.team_name,
    teamLabel(row.team_name, row.display_name),
  ]),
);
const labelFor = (slug: string) => teamLabels.get(slug) ?? teamLabel(slug);

const confirmedDevelopers: ConfirmedDeveloper[] = (confirmedRows ?? []).map(
  (row: any) => ({ ...row, team_label: labelFor(row.team_name) }),
);

const fullRoster: any = [];
teamLeadersQuery?.forEach((leader, index) => {
  fullRoster.push({
    key: index.toString(),
    email: leader.email,
    name: leader.first_name,
    role: leader.role,
  });
});

if (finalUserRole.team_name !== "Board") {
  confirmedDevelopers.forEach((dev) => {
    fullRoster.push({
      key: fullRoster.length.toString(),
      email: dev.email,
      name: dev.full_name,
      role: "Developer",
    });
  });
}

const teamHeading =
  finalUserRole.team_name === "Board" ? "Board" : labelFor(finalUserRole.team_name);
---

<Layout title="JAM - Dashboard">
  <h1 class="text-center text-4xl my-4 font-semibold mx-2">
    Hello {finalUserRole.first_name}!
  </h1>
  <h2 class="text-center text-2xl my-2 mx-2">
    Team: {teamHeading} ({finalUserRole.role})
  </h2>
  <div class="flex justify-center mt-8">
    <SignOut />
  </div>
  <div class="mx-4 lg:mx-8 xl:mx-16 my-8">
    <Card title="My Dev Selection Status" client:only="react">
      <StatusTable rows={selectionStatus as any} client:only="react" />
    </Card>
  </div>
  <div class="mx-4 lg:mx-8 xl:mx-16 my-8">
    <Card title="My Team" client:only="react">
      <TeamTable rows={fullRoster} />
    </Card>
  </div>
  <div class="mx-4 lg:mx-8 xl:mx-16 my-8">
    <Card title="Confirmed Developers" client:only="react">
      <ConfirmedRoster
        rows={confirmedDevelopers}
        showTeam={finalUserRole.team_name === "Board"}
        client:only="react"
      />
    </Card>
  </div>
</Layout>
