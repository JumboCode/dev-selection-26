---
import Layout from "../../layouts/Layout.astro";
import { createAuthenticatedSupabaseClient } from "../../lib/supabase";
import { Button, Card } from "antd";
import DeveloperSelectionTable from "../../components/DeveloperSelectionTable.tsx";

const { cookies, url } = Astro;
const { team } = Astro.params;

if (!team) {
  return Astro.redirect("/dashboard");
}

const projectNameReadable = team
  .replace(/_/g, " ")
  .replace(/\b\w/g, (char) => char.toUpperCase());

const auth = await createAuthenticatedSupabaseClient(cookies);
if (!auth) {
  return Astro.redirect("/");
}

const { supabase, user } = auth;
const { data: userRole, error: userRoleError } = await supabase
  .from("user_roles")
  .select("*")
  .ilike("email", user.email ?? "")
  .maybeSingle();

if (userRoleError || !userRole) {
  console.error(userRoleError || "Unauthorized access.");
  return Astro.redirect("/unauthorized");
}

let canAccessTeam = userRole.team_name === team;
if (userRole.team_name === "Board") {
  const { data: boardScope, error: boardScopeError } = await supabase
    .from("board_selection_scopes")
    .select("team_name")
    .ilike("board_email", user.email ?? "")
    .eq("team_name", team)
    .maybeSingle();

  if (boardScopeError) {
    console.error(boardScopeError);
  }
  canAccessTeam = Boolean(boardScope);
}

if (!canAccessTeam) {
  return Astro.redirect("/unauthorized");
}

// Get Initial Dev Selection Data
const { data: devSelectionData, error: devSelectionFetchError } = await supabase
  .from("pmtl_application_data")
  .select(`*, developer_selections(team_name, selection_type, created_by, created_at)`)
  .order("rank_" + team, { ascending: true });
if (devSelectionFetchError) {
  console.error(devSelectionFetchError);
}

const devData = devSelectionData?.map((entry, index) => {
  return {
    ...entry,
    key: index,
  };
});

const { data: status, error: statusError } = await supabase
  .from("team_status")
  .select("status")
  .eq("team_name", team)
  .maybeSingle();
if (statusError) {
  console.error(statusError);
}
if (!status) {
  return Astro.redirect("/unauthorized");
}

const canEdit = userRole.team_name === "Board"
  ? status.status !== "Complete"
  : status.status === "In Progress";
const accessToken = cookies.get("sb-access-token")?.value ?? "";
const errorMessage = url.searchParams.get("error");
---

<Layout title={"JAM - " + projectNameReadable + " Dev Selection"}>
  <h1 class="text-center text-4xl my-4 font-semibold mx-2">
    {projectNameReadable} Developer Selection
  </h1>
  <h2 class="text-center text-2xl my-2 mx-2">
    {userRole.first_name} ({userRole.role})
  </h2>
  {errorMessage && (
    <p class="mx-auto my-4 max-w-2xl rounded bg-red-100 p-3 text-center text-red-800">
      {errorMessage}
    </p>
  )}

  <div class="flex justify-center my-8">
    <Button
      type="primary"
      size="large"
      shape="round"
      href="/dashboard"
      client:only="react"
    >
      Back to Dashboard
    </Button>
  </div>

  <div class="mx-4 lg:mx-8 xl:mx-16 my-8">
    <Card title="Developer Applications" client:only="react">
      <DeveloperSelectionTable
        channel="channel-2"
        data={devData ?? []}
        team={team}
        accessToken={accessToken}
        canEdit={canEdit}
        supabaseUrl={import.meta.env.SUPABASE_URL}
        supabaseAnonKey={import.meta.env.SUPABASE_ANON_KEY}
        client:only="react"
      />
    </Card>
  </div>

  <div class="mx-4 lg:mx-8 xl:mx-16 my-8">
    <Card title={"Board Approval"} client:only="react">
      <p>Developer Selection Checklist:</p>
      <ul class="list-disc ml-8 mb-4">
        <li class="list-item">Have you selected 10 developers?</li>
        <li class="list-item">
          Have you selected 1-3 developers for the waitlist?
        </li>
        <li class="list-item">
          Have you selected at least one first-year developer? (Class of 2030)
        </li>
      </ul>
      {
        userRole.team_name === "Board" ? (
          <div>
            <h2 class="mb-2 text-xl font-semibold">
              Board: Approve Developer Selections
            </h2>
            <form action="/api/approve" method="post">
              <input type="hidden" name="team" value={team} />
              <Button
                client:only="react"
                type="primary"
                htmlType="submit"
                disabled={status.status !== "Under Review"}
              >
                Approve Selections
              </Button>
            </form>
          </div>
        ) : (
          <div>
            <h2 class="mb-2 text-xl font-semibold">
              {userRole.role} ({userRole.team_name}) Send For Approval
            </h2>
            <form action="/api/sendapproval" method="post">
              <Button
                client:only="react"
                type="primary"
                htmlType="submit"
                disabled={status.status !== "In Progress"}
              >
                Send for Board Approval
              </Button>
            </form>
          </div>
        )
      }
    </Card>
  </div>
</Layout>
