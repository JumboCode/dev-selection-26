# These tests delete selection rows and reset team statuses. Use a dedicated
# Supabase test project, never the production project.
RUN_SUPABASE_INTEGRATION_TESTS=1
SUPABASE_TEST_ALLOW_DESTRUCTIVE=YES_I_AM_USING_A_TEST_DATABASE
SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_ANON_KEY=your-test-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key

# Include every team to exercise them all concurrently. Each account must have
# a matching user_roles row in the migrated test database.
SUPABASE_TEST_USERS=[{"email":"team-a@example.com","password":"password","team":"team_a"},{"email":"team-b@example.com","password":"password","team":"team_b"}]

# At least 14 existing, disposable pmtl_application_data.fake_name values.
SUPABASE_TEST_FAKE_NAMES=Test Dev 01,Test Dev 02,Test Dev 03,Test Dev 04,Test Dev 05,Test Dev 06,Test Dev 07,Test Dev 08,Test Dev 09,Test Dev 10,Test Dev 11,Test Dev 12,Test Dev 13,Test Dev 14
